# ==============================
# LectureMind environment config
# Copy this file to backend/.env and fill in the values you need.
# ==============================

# General
ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./data/metadata/lecturemind.db

# Upload validation
MAX_UPLOAD_SIZE_MB=500

# Whisper / ASR (faster-whisper)
# Model size options: tiny, base, small, medium, large-v3 (bigger = more accurate, slower)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Embeddings (local, free, no API key required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE_WORDS=650
CHUNK_OVERLAP_WORDS=120

# Retrieval
TOP_K=5

# ------------------------------
# LLM Provider: choose ONE of "ollama", "openai", "groq"
# ------------------------------
LLM_PROVIDER=ollama

# Ollama (default, fully local, no API key needed)
# Install from https://ollama.com, then run:
#   ollama pull llama3.1:8b
#   ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI (optional alternative — requires an API key and internet access)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (optional alternative — fast, free-tier available, requires an API key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

LLM_TIMEOUT_SECONDS=120
