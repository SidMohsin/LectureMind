# Base URL of the FastAPI backend used by the frontend API client.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and anon / publishable key (Project Settings -> API Keys).
# Both are public values that ship to the browser. Never put the service-role /
# secret key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
