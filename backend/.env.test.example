# Copy to backend/.env.test (git-ignored) to run the live Supabase security
# suite:  pytest -m integration
#
# Use a DEVELOPMENT project only. The suite creates and deletes throwaway
# users (lecturemind-test-*@example.com) and their lectures/media.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role / secret key. Used ONLY by the test suite to create, confirm and
# delete test users. The application never reads this value.
SUPABASE_SERVICE_ROLE_KEY=
# Frontend origin configured in Supabase Auth (Site URL / redirect allow-list).
APP_URL=http://localhost:5173
