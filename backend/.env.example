# Environment: development | staging | production
ENVIRONMENT=development
APP_NAME=LectureMind API
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Supabase (Phase 2: authentication + data) ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Anon / publishable key (Project Settings -> API Keys). This is a public key;
# the backend forwards each user's own access token so RLS still applies.
SUPABASE_ANON_KEY=
# Leave empty unless your project still signs tokens with the legacy shared
# HS256 JWT secret. Projects using JWT signing keys are verified via JWKS.
SUPABASE_JWT_SECRET=

# --- Reserved for later phases (unused so far) ---
# DATABASE_URL=        # Phase 4 workers
# REDIS_URL=           # Phase 4 processing queue
# LLM_PROVIDER=        # Phase 6 grounded Q&A
# LLM_API_KEY=
