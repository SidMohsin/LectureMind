# Environment: development | staging | production
ENVIRONMENT=development
APP_NAME=LectureMind API
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API in development.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Configured in later phases, not required to run Phase 1 ---

# Supabase (Phase 2: Auth + Storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Database (Phase 2: PostgreSQL + pgvector)
DATABASE_URL=

# Redis / job queue (Phase 4: async processing)
REDIS_URL=

# LLM provider (Phase 6: grounded Q&A)
LLM_PROVIDER=
LLM_API_KEY=
