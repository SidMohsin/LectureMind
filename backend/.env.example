# Environment: development | staging | production
ENVIRONMENT=development
APP_NAME=LectureMind API
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Supabase ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Anon / publishable key (Project Settings -> API Keys). Used for user-scoped
# reads, which forward each user's own access token so RLS applies.
SUPABASE_ANON_KEY=
# Service-role / secret key. SERVER-SIDE ONLY: used for ingestion writes after
# the API has verified ownership, and by the processing worker. Never put this
# in any frontend (VITE_) variable.
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty unless your project still signs tokens with the legacy shared
# HS256 JWT secret. Projects using JWT signing keys are verified via JWKS.
SUPABASE_JWT_SECRET=

# --- Processing queue + worker (Phase 4) ---
REDIS_URL=redis://localhost:6379/0
# Scratch space for downloads and FFmpeg output (default: system temp dir).
WORK_DIR=
# Override if ffmpeg/ffprobe aren't on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Ingestion limits (authoritative; the frontend reads them from the API) ---
# Supabase's free plan caps each stored file at 50 MB; raise these only if
# your project's storage file-size limit allows it.
MAX_VIDEO_BYTES=2147483648
MAX_AUDIO_BYTES=524288000
MAX_MEDIA_DURATION_SECONDS=14400
SOURCE_URL_DOWNLOADS_ENABLED=true

# --- Lecture intelligence (Phase 5) ---
# Model downloads are cached here (default: ~/.cache/lecturemind-models).
MODEL_CACHE_DIR=
# faster-whisper model (tiny, base, small, medium, large-v3, distil-large-v3, ...).
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_BEAM_SIZE=5
# Empty = detect the spoken language.
TRANSCRIPTION_LANGUAGE=
# fastembed model; changing it requires re-embedding (dimension must match the DB column).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
# OpenAI-compatible chat API, e.g.
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_WINDOW_TOKENS=12000
# Response cap per request. Providers with per-minute token limits (e.g. Groq free tier:
# 8000 TPM incl. max_tokens) need smaller values, e.g. LLM_WINDOW_TOKENS=3000, LLM_MAX_OUTPUT_TOKENS=2500.
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TIMEOUT_SECONDS=180
LLM_RATE_LIMIT_RETRIES=6
# Reasoning models (gpt-oss, o-series): low | medium | high. Leave empty for other models.
LLM_REASONING_EFFORT=

# --- Lecture workspace + grounded Q&A (Phase 6) ---
# Private playback audio stored for URL lectures (lowered to fit PLAYBACK_MAX_BYTES,
# which must not exceed the storage plan's per-file limit: 50 MB on Supabase Free).
PLAYBACK_AUDIO_BITRATE_KBPS=48
PLAYBACK_MIN_BITRATE_KBPS=24
PLAYBACK_MAX_BYTES=50331648
MEDIA_URL_TTL_SECONDS=3600
# Retrieval for questions: chunks fetched, minimum cosine similarity to count as evidence
# (calibrated for BAAI/bge-small-en-v1.5; see README), evidence budget and answer cap.
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.6
RAG_CONTEXT_TOKENS=2400
RAG_MAX_OUTPUT_TOKENS=900
RAG_RATE_LIMIT_RETRIES=1
